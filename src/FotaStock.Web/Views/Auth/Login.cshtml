@{

    ViewData["Title"] = "Login";
}

<div class="container mt-5" id="app">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card-shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4>Iniciar Sesión</h4>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label>Usuario</label>
                        <input type="text" id="username" name="username" class="form-control" v-model="data.nombre" required placeholder="Ingrese su usuario">
                    </div>
                    <div class="form-group mb-3">
                        <label>Contraseña</label>
                        <input type="password" id="password" name="password" class="form-control" v-model="data.password" required placeholder="Ingrese su usuario">
                    </div>
                    <div v-if="BrindarError" class="mt-2 mb-4">
                       <span class="alert alert-danger text-danger" role="alert">{{error}}</span> 
                    </div>
                    <div class="d-flex justify-content-between">
                        <button class="btn btn-primary" v-on:click="loguearse">Iniciar Sesion</button>
                        <button class="btn btn-secondary" v-on:click="irRegistro">Registrarse</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {

   
    <script>
    const{createApp, ref} = Vue;
       

        
        createApp(
        {
            setup() 
            {
                
                const error = ref("");
                const data = ref({});
                const BrindarError = ref(false);
                

                const irRegistro = () => {
                    console.log("register")
                    window.location.href = '@Url.Action("Register", "Auth")';
                }
            

                const loguearse = async () => {
                    
                    error.value="";
                    BrindarError.value=false;

                    const respuesta = await fetch('/Auth/Login' , 
                    {
                        method: "POST",
                        headers: {'Content-Type': 'application/json;charset=utf-8'},
                        body: JSON.stringify({
                            nombre:data.value.nombre, password:data.value.password
                        })
                    });

                    const datosRespuesta = await respuesta.json();

                    if (datosRespuesta.success) {
        
                        window.location.href = datosRespuesta.redirectTo;
                    } 
                    else 
                    {
                            
                        error.value = datosRespuesta.message; 
                        BrindarError.value = true;
                        console.log(error.value);
                    }

                }

                    

                return {
                loguearse, irRegistro, error, data, BrindarError
                }
                
            }   

            
                
        }).mount("#app")


    </script>

}