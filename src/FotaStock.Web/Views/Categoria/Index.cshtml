

<div id="app">
    <div class="row justify-content-between mt-4">
        <div v-if="creado">
            <h5 class="alert theme-success" role="alert">Se ha creado con exito la categoria</h5>
        </div>
        <div v-if="error">
            <h5 class="alert theme-danger" role="alert">Error en crear la categoria</h5>
        </div>
        <div class="col-4">
            <h4>Categorias</h4>

        </div>
        <div class="col-4 text-end">
            <a href="#" class="btn btn-success" type= "button" v-on:click="saveCategoria">
                <i class="fa-solid fa-circle-plus"></i> Crear nueva categoria
            </a>
            <hr/>
            
            <label class="form-label">Ingresar nombre de la categoria</label>
            <input type="text" class="form-control" id="nombre" autocomplete="off" v-model="data.nombre">
            <label class="form-label">Ingresar descripcion de la categoria</label>
            <input type="text" class="form-control" id="nombre" autocomplete="off" v-model="data.descripcion">

        </div>

    </div>

    <hr/>

    <table class="table table-striped">
        <thead>
            <tr>
                <th style="width:4vh">
                    Nombre

                </th>
                <th style="width:20vh">
                    Descripcion
                </th>
                <th style="width:4vh"> Acciones </th>
            </tr>
        </thead>
        <tbody>
                
                <tr v-for="c in categorias"> 
                <td style="width:4vh">{{c.nombre}}</td>
                    <th style="width:20vh">
                    {{c.descripcion}}
                    </th>
                    <th style="width:4vh">
                    <a href="#" class="btn btn-sm btn-primary"><i class="fa-solid fa-pen-nib"></i></a>
                    <button class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i></button>
                    </th>
                </tr>
            
        </tbody>

    </table>
</div>


@section Scripts {

      
    
    <script>

        
        

        const{createApp, ref} = Vue

        
        createApp({
            setup() {  
                           
                
                const data = ref([]);
                const categorias = ref([]);
                const isToCreate = ref(true);

                const saveCategoria = () => {
                    fetch('/Categoria/AddEdit' , 
                    {
                        method: "POST",
                        headers: {'Content-Type': 'application/json;charset=utf-8'},
                        body: JSON.stringify({
                            nombre:data.value.nombre, descripcion:data.value.descripcion
                        })
                    }).then(response => {
                        if(response.ok) {
                            data.value.nombre = ""
                            data.value.descripcion = ""
                        }
                        showCategorias();
                    })
                    


                }
                
                const showCategorias = () => {
                    fetch('/Categoria/GetAll', 
                    {
                        method: "GET",
                    })
                    .then(response => {return response.json()}).then(data => 
                        {
                            
                            categorias.value = data
                        })
                }


                //A tener en cuenta. se debe colocar los nombres de las tablas en minuscula, ej (nombre)
                showCategorias();

                return {categorias, isToCreate,showCategorias, data, saveCategoria} 
            }

        }).mount("#app")
        
    

    </script>


}
