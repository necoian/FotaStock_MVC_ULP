<div id="app">
    <div class="row justify-content-between mt-4">
        <transition name="agregar">
            <h3 class="alert alert-success" role="alert" v-if="mensajeGuardado!=''">
                {{mensajeGuardado}}
            </h3>
        </transition>
        <div class="col-4">
            <h4>Categorias</h4>

        </div>
        <div class="col-4 text-end">
            <a href="#" class="btn btn-success" type= "button" v-on:click="mostrarFormulario = !mostrarFormulario">
                <i class="fa-solid fa-circle-plus"></i> Crear nueva categoria
            </a>

        </div>
            <transition name="agregar">
                <div v-if="mostrarFormulario">
                <hr/>
                    <label class="form-label">Ingresar nombre de la categoria</label>
                    <input type="text" class="form-control" id="nombre" autocomplete="off" v-model="data.nombre">
                    <div v-if="errores?.Nombre" class="text-danger">
                        
                            <span v-for="nombre in errores.Nombre">
                                {{nombre}}
                            </span>
                        
                    </div>
                    <label class="form-label">Ingresar descripcion de la categoria</label>
                    <input type="text" class="form-control" id="descripcion" autocomplete="off" v-model="data.descripcion">
                    <div v-if="errores?.Descripcion" class="text-danger">
                        
                            <span v-for="descripcion in errores.Descripcion">
                                {{descripcion}}
                            </span>
                        
                    </div>
                    <div class="container text-center mt-2">
                        <div class="row align-items-start">
                                <div class="col">
                                <a href="#" class="btn btn-success" type= "button" v-on:click="saveCategoria" v-if="isToCreate">
                                    Guardar
                                </a>
                                <a href="#" class="btn btn-success" type= "button" v-on:click="saveChangedCategorias" v-if="!isToCreate">
                                    Editar
                                </a>
                                
                            </div>
                            <div class="col">
                                <a href="#" class="btn btn-danger" type= "button" v-on:click="canceleditCategorias">
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </div>

                    

                </div>
            </transition>

    </div>

    <hr/>

    <table class="table table-striped">
        <thead>
            <tr>
                <th style="width:4vh">
                    Nombre

                </th>
                <th style="width:20vh">
                    Descripcion
                </th>
                <th style="width:4vh"> Acciones </th>
            </tr>
        </thead>
        <tbody>
                
                <tr v-for="c in categorias"> 
                <td style="width:4vh">{{c.nombre}}</td>
                    <th style="width:20vh">
                    {{c.descripcion}}
                    </th>
                    <th style="width:4vh">
                    <a href="#" class="btn btn-sm btn-primary" v-on:click="editCategorias(c)"><i class="fa-solid fa-pen-nib"></i></a>
                    <a href="#" class="btn btn-sm btn-danger" v-on:click="deleteCategoria(c.categoriaId)"><i class="fa-solid fa-trash"></i></a>
                    </th>
                </tr>
            
        </tbody>

    
    </table>
    <div class="container text-center mt-4" >
        <a href="#" style="color:inherit" v-on:click="atrasAdelante(-1)"><i class="fa-solid fa-chevron-left"></i></a>
        <span class=" m-1" v-for="i in indice">
            <a href="#" style="text-decoration:none; color:inherit" v-on:click="showCategoriasPaginado(i)"
             v-bind:style="[{fontSize : (currentPage==i) ? '1.5em' : '1em'} , {color : (currentPage==i) ? 'red' : 'inherit' }]">{{i}}</a>
        </span> 
        <a href="#" style="color:inherit" v-on:click="atrasAdelante(1)"><i class="fa-solid fa-chevron-right"></i></a>
    </div>
    
    
</div>


@section Scripts {

      
    
    <script>

        const{createApp, ref} = Vue

        
        createApp({
            setup() {  
                           
                const mostrarFormulario = ref(false);
                const errores = ref({});
                const indice = ref([]);
                const currentPage = ref([]);
                const totalPages = ref();
                const hasPreviousPage = ref(false);
                const hasNextPage = ref(false);
                let mensajeGuardado = ref('');
                const data = ref([]);
                const categorias = ref([]);
                const isToCreate = ref(true);

                function guardadoOK (mensaje, tiempo = 2000) {
                    mensajeGuardado.value = mensaje;
                    setInterval(() => {
                        mensajeGuardado.value = '';
                    }, tiempo);
                    
                }

                const saveCategoria = async () => {
                    
                    errores.value = {};

                    const respuesta = await fetch('/Categoria/AddEdit' , 
                    {
                        method: "POST",
                        headers: {'Content-Type': 'application/json;charset=utf-8'},
                        body: JSON.stringify({
                            nombre:data.value.nombre, descripcion:data.value.descripcion
                        })
                    });
                    if(!respuesta.ok)
                    {
                        if(respuesta.status == 400) {
                        
                            const errorJSON = await respuesta.json();
                            errores.value = errorJSON;
                            console.log(errores.value);

                        } 
                        
                    }
                    else 
                    {

                        data.value.nombre = ""
                        data.value.descripcion = ""
                        guardadoOK("Categoria cargada con éxito");
                        showCategoriasPaginado(currentPage.value);
                    }
                    


                }
                
                const showCategorias = () => {
                    fetch('/Categoria/GetAll', 
                    {
                        method: "GET",
                    })
                    .then(response => {return response.json()}).then(data => 
                        {
                            
                            categorias.value = data
                        })
                }

                const showCategoriasPaginado = async (index = 1) => {

                    

                    const respuesta = await fetch(`/Categoria/GetPorPagina?pageIndex=${index}`, 
                    {

                        method: "GET",

                    });

                    if(respuesta.ok) {
                        currentPage.value = index;
                        const categoriaJSON = await respuesta.json();
                        categorias.value = categoriaJSON.items;
                        console.log(categoriaJSON);
                        totalPages.value = categoriaJSON.totalPages;
                        if(totalPages.value < categoriaJSON.pageIndex) {
                            currentPage.value--;
                            showCategoriasPaginado(currentPage.value);
                        }
                        hasNextPage.value = categoriaJSON.hasNextPage;
                        hasPreviousPage.value = categoriaJSON.hasPreviousPage;
                        cambiarIndice();

                        

                    } else {
                        currentPage.value--;
                        showCategoriasPaginado(currentPage.value);
                    }

                }

                async function atrasAdelante(posicion) {

                    console.log(hasPreviousPage);
                    console.log(hasNextPage);
                    if(posicion == -1 && hasPreviousPage.value) {
                        currentPage.value--;
                        return await showCategoriasPaginado(currentPage.value);
                    } else if(posicion == 1 && hasNextPage.value){
                        currentPage.value++;
                        return await showCategoriasPaginado(currentPage.value);
                    } else {
                        return await showCategoriasPaginado(currentPage.value);
                    }




                }

                async function cambiarIndice() {
                        indice.value = {};               
                        let contador = 1;
                        for(    i = 0; i<totalPages.value;i++) {
                            indice.value = contador;
                            contador++;
                        }                       
                        return await indice;

                }

                const editCategorias = (c) => {
                    mostrarFormulario.value = true;
                    isToCreate.value = false;
                    data.value.categoriaId = c.categoriaId;
                    data.value.nombre = c.nombre;
                    data.value.descripcion = c.descripcion;
                    
                }

                const canceleditCategorias = () => {
                    isToCreate.value = true;
                    data.value.categoriaId = 0;
                    data.value.nombre = '';
                    data.value.descripcion = '';
                    mostrarFormulario.value = false;
                }

                const saveChangedCategorias = async () => {

                    errores.value = {};

                    const respuesta = await fetch('/Categoria/AddEdit' , 
                    {
                        method: "POST",
                        headers: {'Content-Type': 'application/json;charset=utf-8'},
                        body: JSON.stringify({
                            categoriaId: data.value.categoriaId, nombre:data.value.nombre, descripcion:data.value.descripcion
                        })
                    });
                    if(!respuesta.ok)
                    {
                        if(respuesta.status == 400) {
                        
                            const errorJSON = await respuesta.json();
                            errores.value = errorJSON;
                            console.log(errores.value);

                        } 
                        
                    }
                    else 
                    {

                        const index = categorias.value.findIndex(c => c.categoriaId == data.value.categoriaId);

                        categorias.value[index].nombre = data.value.nombre;
                        categorias.value[index].descripcion = data.value.descripcion;

                        guardadoOK("Categoria actualizada con exito");
                        canceleditCategorias();
                        showCategoriasPaginado(currentPage.value);
                    }

                }

                const deleteCategoria = async (id) => {

                    const respuesta = await fetch(`/Categoria/Delete?id=${id}` , 
                    {
                        method: "DELETE",                       
                    });
                    if(respuesta.ok) {
                        const index = categorias.value.findIndex(c => c.categoriaId == id);
                        categorias.value.splice(index, 1);
                        guardadoOK("Categoria eliminada con exito");
                        console.log(currentPage.value);
                        await showCategoriasPaginado(currentPage.value);
                    }

                }
                
                


                //A tener en cuenta. se debe colocar los nombres de las tablas en minuscula, ej (nombre)
                showCategoriasPaginado();

                return {categorias, isToCreate,showCategorias, data, saveCategoria,
                 mostrarFormulario, guardadoOK, mensajeGuardado, errores, editCategorias,
                  canceleditCategorias, saveChangedCategorias, deleteCategoria, indice, showCategoriasPaginado, cambiarIndice, atrasAdelante, 
                  currentPage} 
            }

        }).mount("#app")
        
    

    </script>


}


<style>

.agregar-enter-active, .agregar-leave-active {
    transition: opacity 0.5s ease;
}

.agregar-enter-from, .agregar-leave-to {
    opacity: 0;
}

</style>

