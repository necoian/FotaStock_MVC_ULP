@startuml DER_FotaStock_Completo_Espaciado
' Modelo conceptual preliminar de FotaStock.
' PK = clave primaria | FK = clave foranea | UNIQUE = valor unico.
' Las entidades se agrupan por responsabilidad funcional.
' Los textos descriptivos de las relaciones se trasladan a la guia complementaria
' para evitar que se monten sobre entidades o cardinalidades.

title FotaStock - Diagrama Entidad-Relacion (DER) preliminar
left to right direction
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam entityAttributeIconSize 0
skinparam nodesep 58
skinparam ranksep 68
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.5
skinparam package {
  BorderColor #CBD5E1
  FontColor #334155
  FontStyle bold
  BackgroundColor #F8FAFC
}
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #0F172A
}

package "01. Identidad y perfiles" as Identidad #EFF6FF {
  entity "ORGANIZACION" as Organizacion {
    * organizacion_id : BIGINT <<PK>>
    --
    razon_social : VARCHAR
    cuit : VARCHAR <<UNIQUE>>
    email_facturacion : VARCHAR
    estado : VARCHAR
  }

  entity "USUARIO" as Usuario {
    * usuario_id : BIGINT <<PK>>
    --
    FK organizacion_id : BIGINT (opcional)
    nombre : VARCHAR
    email : VARCHAR <<UNIQUE>>
    password_hash : VARCHAR
    rol : VARCHAR
    estado : VARCHAR
    avatar_url : VARCHAR
  }

  entity "PERFIL_FOTOGRAFO" as PerfilFotografo {
    * perfil_fotografo_id : BIGINT <<PK>>
    --
    FK usuario_id : BIGINT <<UNIQUE>>
    biografia : TEXT
    ubicacion : VARCHAR
    estado_habilitacion : VARCHAR
  }
}

package "02. Catalogo y derechos" as Catalogo #F0FDFA {
  entity "ACTIVO" as Activo {
    * activo_id : BIGINT <<PK>>
    --
    FK fotografo_usuario_id : BIGINT
    titulo : VARCHAR
    descripcion : TEXT
    ubicacion : VARCHAR
    etiquetas : TEXT
    estado_publicacion : VARCHAR
  }

  entity "ARCHIVO_ACTIVO" as ArchivoActivo {
    * archivo_activo_id : BIGINT <<PK>>
    --
    FK activo_id : BIGINT
    tipo : VARCHAR (original/preview)
    ruta_privada : VARCHAR
    marca_agua : BOOLEAN
    hash_integridad : VARCHAR
  }

  entity "RELEASE" as Release {
    * release_id : BIGINT <<PK>>
    --
    FK activo_id : BIGINT
    tipo : VARCHAR (persona/propiedad)
    titular : VARCHAR
    documento : VARCHAR
    estado : VARCHAR
  }

  entity "VERSION_LICENCIA" as VersionLicencia {
    * version_licencia_id : BIGINT <<PK>>
    --
    nombre : VARCHAR
    numero_version : INT
    terminos : TEXT
    restricciones : TEXT
    vigencia : VARCHAR
    activa : BOOLEAN
  }

  entity "OFERTA_LICENCIA" as OfertaLicencia {
    * oferta_licencia_id : BIGINT <<PK>>
    --
    FK activo_id : BIGINT
    FK version_licencia_id : BIGINT
    precio : DECIMAL
    moneda : CHAR(3)
    estado : VARCHAR
    vigencia : VARCHAR
  }

  entity "COLECCION" as Coleccion {
    * coleccion_id : BIGINT <<PK>>
    --
    FK comprador_usuario_id : BIGINT
    nombre : VARCHAR
    privacidad : VARCHAR
    fecha_creacion : DATETIME
  }

  entity "COLECCION_ACTIVO" as ColeccionActivo {
    * PK/FK coleccion_id : BIGINT
    * PK/FK activo_id : BIGINT
    --
    fecha_agregado : DATETIME
  }
}

package "03. Comercializacion y acceso" as Comercio #FFF7ED {
  entity "ORDEN" as Orden {
    * orden_id : BIGINT <<PK>>
    --
    FK comprador_usuario_id : BIGINT
    fecha : DATETIME
    estado : VARCHAR
    total : DECIMAL
    moneda : CHAR(3)
  }

  entity "ITEM_ORDEN" as ItemOrden {
    * item_orden_id : BIGINT <<PK>>
    --
    FK orden_id : BIGINT
    FK oferta_licencia_id : BIGINT
    FK version_licencia_id : BIGINT
    precio_congelado : DECIMAL
    comision_congelada : DECIMAL
  }

  entity "PAGO" as Pago {
    * pago_id : BIGINT <<PK>>
    --
    FK orden_id : BIGINT
    proveedor : VARCHAR
    referencia_externa : VARCHAR
    importe : DECIMAL
    estado : VARCHAR
    fecha : DATETIME
  }

  entity "LICENCIA_EMITIDA" as LicenciaEmitida {
    * licencia_emitida_id : BIGINT <<PK>>
    --
    FK item_orden_id : BIGINT <<UNIQUE>>
    FK comprador_usuario_id : BIGINT
    FK version_licencia_id : BIGINT
    estado : VARCHAR
    fecha_emision : DATETIME
  }

  entity "DESCARGA" as Descarga {
    * descarga_id : BIGINT <<PK>>
    --
    FK licencia_emitida_id : BIGINT
    fecha : DATETIME
    resultado : VARCHAR
    vencimiento_token : DATETIME
  }

  entity "MOVIMIENTO_ECONOMICO" as MovimientoEconomico {
    * movimiento_id : BIGINT <<PK>>
    --
    FK item_orden_id : BIGINT
    FK fotografo_usuario_id : BIGINT
    tipo : VARCHAR
    importe : DECIMAL
    moneda : CHAR(3)
    fecha : DATETIME
  }
}

package "04. Moderacion y confianza" as Confianza #FFF1F2 {
  entity "REVISION_MODERACION" as RevisionModeracion {
    * revision_id : BIGINT <<PK>>
    --
    FK activo_id : BIGINT
    FK moderador_usuario_id : BIGINT
    decision : VARCHAR
    motivo : TEXT
    fecha : DATETIME
  }

  entity "DENUNCIA" as Denuncia {
    * denuncia_id : BIGINT <<PK>>
    --
    FK activo_id : BIGINT
    FK usuario_denunciante_id : BIGINT
    motivo : VARCHAR
    estado : VARCHAR
    evidencia_url : VARCHAR (opcional)
    fecha_resolucion : DATETIME
  }
}

' Identidad
' Relacion: Organizacion -- Usuario; etiqueta descriptiva: usuarios
Organizacion "0..1" -[#2563EB]- "0..*" Usuario
' Relacion: Usuario -- PerfilFotografo; etiqueta descriptiva: perfil
Usuario "1" -[#2563EB]- "0..1" PerfilFotografo

' Regla funcional: un Activo publicado debe tener un original privado y al menos una vista previa.
' Se mantiene 0..* porque un Activo en borrador puede existir antes de cargar sus archivos.
' Catalogo y derechos
' Relacion: Usuario -- Activo; etiqueta descriptiva: publica
Usuario "1" -[#0F9D8A]- "0..*" Activo
' Relacion: Activo -- ArchivoActivo; etiqueta descriptiva: archivos
Activo "1" -[#0F9D8A]- "0..*" ArchivoActivo
' Relacion: Activo -- Release; etiqueta descriptiva: releases
Activo "1" -[#0F9D8A]- "0..*" Release
' Relacion: Activo -- OfertaLicencia; etiqueta descriptiva: ofertas
Activo "1" -[#0F9D8A]- "0..*" OfertaLicencia
' Relacion: VersionLicencia -- OfertaLicencia; etiqueta descriptiva: define
VersionLicencia "1" -[#0F9D8A]- "0..*" OfertaLicencia
' Relacion: Usuario -- Coleccion; etiqueta descriptiva: crea
Usuario "1" -[#0F9D8A]- "0..*" Coleccion
' Relacion: Coleccion -- ColeccionActivo; etiqueta descriptiva: items
Coleccion "1" -[#0F9D8A]- "0..*" ColeccionActivo
' Relacion: Activo -- ColeccionActivo; etiqueta descriptiva: incluye
Activo "1" -[#0F9D8A]- "0..*" ColeccionActivo

' Comercio
' Relacion: Usuario -- Orden; etiqueta descriptiva: compra
Usuario "1" -[#D97706]- "0..*" Orden
' Relacion: Orden -- ItemOrden; etiqueta descriptiva: items
Orden "1" -[#D97706]- "1..*" ItemOrden
' Relacion: OfertaLicencia -- ItemOrden; etiqueta descriptiva: oferta
OfertaLicencia "1" -[#D97706]- "0..*" ItemOrden
' Relacion: VersionLicencia -- ItemOrden; etiqueta descriptiva: versión
VersionLicencia "1" -[#D97706]- "0..*" ItemOrden
' Relacion: Orden -- Pago; etiqueta descriptiva: pagos
Orden "1" -[#D97706]- "0..*" Pago
' Relacion: ItemOrden -- LicenciaEmitida; etiqueta descriptiva: emite
ItemOrden "1" -[#D97706]- "0..1" LicenciaEmitida
' Relacion: Usuario -- LicenciaEmitida; etiqueta descriptiva: comprador
Usuario "1" -[#D97706]- "0..*" LicenciaEmitida
' Relacion: VersionLicencia -- LicenciaEmitida; etiqueta descriptiva: versión
VersionLicencia "1" -[#D97706]- "0..*" LicenciaEmitida
' Relacion: LicenciaEmitida -- Descarga; etiqueta descriptiva: descargas
LicenciaEmitida "1" -[#D97706]- "0..*" Descarga
' Relacion: ItemOrden -- MovimientoEconomico; etiqueta descriptiva: liquidación
ItemOrden "1" -[#D97706]- "0..*" MovimientoEconomico
' Relacion: Usuario -- MovimientoEconomico; etiqueta descriptiva: fotógrafo
Usuario "1" -[#D97706]- "0..*" MovimientoEconomico

' evidencia_url permite registrar una URL o referencia a evidencia adjunta de la denuncia.
' Moderacion y confianza
' Relacion: Activo -- RevisionModeracion; etiqueta descriptiva: revisiones
Activo "1" -[#C2415B]- "0..*" RevisionModeracion
' Relacion: Usuario -- RevisionModeracion; etiqueta descriptiva: modera
Usuario "1" -[#C2415B]- "0..*" RevisionModeracion
' Relacion: Activo -- Denuncia; etiqueta descriptiva: denuncias
Activo "1" -[#C2415B]- "0..*" Denuncia
' Relacion: Usuario -- Denuncia; etiqueta descriptiva: reporta
Usuario "1" -[#C2415B]- "0..*" Denuncia

legend bottom
  |= Notacion |= Significado |
  | PK | Clave primaria |
  | FK | Clave foranea |
  | UNIQUE | Valor unico |
  | 1 -- 0..* | Uno a cero o muchos |
  | 1 -- 0..1 | Uno a cero o uno |
  | 1 -- 1..* | Uno a uno o muchos |
endlegend
@enduml
