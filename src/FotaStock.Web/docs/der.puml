@startuml
title FotaStock - DER
hide circle
left to right direction

skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 160
skinparam padding 1



entity "Usuario" as Usuario {
    * UsuarioId : INT <<PK>>
    --
    Nombre : VARCHAR(100)
    Email : VARCHAR(150) <<UNIQUE>>
    PasswordHash : VARCHAR(255)
    Rol : VARCHAR(30)
    AvatarRuta : VARCHAR(500)
    FechaAlta : DATETIME
}

entity "Categoria" as Categoria {
    * CategoriaId : INT <<PK>>
    --
    Nombre : VARCHAR(100) <<UNIQUE>>
    Descripcion : VARCHAR(500)
}

entity "Imagen" as Imagen {
    * ImagenId : INT <<PK>>
    --
    UsuarioId : INT <<FK>>
    CategoriaId : INT <<FK>>
    Titulo : VARCHAR(150)
    Descripcion : VARCHAR(1000)
    Ubicacion : VARCHAR(150)
    Estado : VARCHAR(30)
    FechaPublicacion : DATETIME
}

entity "ArchivoImagen" as ArchivoImagen {
    * ArchivoImagenId : INT <<PK>>
    --
    ImagenId : INT <<FK>>
    TipoArchivo : VARCHAR(20)
    RutaAlmacenamiento : VARCHAR(500)
    TieneMarcaAgua : BOOLEAN
    HashIntegridad : VARCHAR(128)
    FechaCarga : DATETIME
}

entity "OfertaLicencia" as OfertaLicencia {
    * OfertaLicenciaId : INT <<PK>>
    --
    ImagenId : INT <<FK>>
    Nombre : VARCHAR(100)
    Condiciones : TEXT
    Precio : DECIMAL(10,2)
    Moneda : CHAR(3)
    Estado : VARCHAR(30)
    FechaVigenciaDesde : DATETIME
    FechaVigenciaHasta : DATETIME (NULL)
}

entity "Compra" as Compra {
    * CompraId : INT <<PK>>
    --
    UsuarioId : INT <<FK>>
    Fecha : DATETIME
    Estado : VARCHAR(30)
    Total : DECIMAL(10,2)
    Moneda : CHAR(3)
}

entity "Pago" as Pago {
    * PagoId : INT <<PK>>
    --
    CompraId : INT <<FK>>
    Monto : DECIMAL(10,2)
    FechaIntento : DATETIME
    FechaRespuesta : DATETIME (NULL)
    Estado : VARCHAR(30)
    Metodo : VARCHAR(30)
    Referencia : VARCHAR(100) <<UNIQUE>>
}

entity "DetalleCompra" as DetalleCompra {
    * DetalleCompraId : INT <<PK>>
    --
    CompraId : INT <<FK>>
    OfertaLicenciaId : INT <<FK>>
    PrecioUnitario : DECIMAL(10,2)
    CondicionesSnapshot : TEXT
}

entity "Licencia" as Licencia {
    * LicenciaId : INT <<PK>>
    --
    DetalleCompraId : INT <<FK, UNIQUE>>
    Codigo : VARCHAR(100) <<UNIQUE>>
    FechaEmision : DATETIME
    Estado : VARCHAR(30)
}

Usuario "1" -down- "0..N" Imagen : publica
Categoria "1" -down- "0..N" Imagen : clasifica
Imagen "1" -down- "0..N" ArchivoImagen : tiene archivos
Imagen "1" -right- "0..N" OfertaLicencia : ofrece
Usuario "1" -left- "0..N" Compra : realiza
Compra "1" -down- "1..N" DetalleCompra : contiene
Compra "1" -right- "0..N" Pago : registra intentos
OfertaLicencia "1" -down- "0..N" DetalleCompra : seleccionada en
DetalleCompra "1" -right- "0..1" Licencia : genera


@enduml
